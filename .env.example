# Copia este archivo como .env y llena los valores. Nunca subas el .env a GitHub.

# Cadena de conexión a PostgreSQL.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/licene"

# Clave para firmar las sesiones (mínimo 32 caracteres, aleatoria y secreta).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
